# Local LLM (OpenAI-compatible endpoint).
# LM Studio default; for Ollama use http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=local
# Must match a tool-capable model loaded in LM Studio / pulled in Ollama.
LLM_MODEL=qwen2.5-7b-instruct

# Mock Tavily web search + Wikipedia so the graphs run offline.
# Set to false to call the real services (then set TAVILY_API_KEY).
USE_MOCKS=true
# TAVILY_API_KEY="tvly-xxxx"   # only needed when USE_MOCKS=false
