# LangChain Academy — local configuration.
# Copy to `.env` (`cp .env.example .env`) and adjust to match your local setup.

# --- Local LLM (OpenAI-compatible endpoint) ---------------------------------
# LM Studio (default). Ollama: http://localhost:11434/v1 — mlx-lm: http://localhost:8080/v1
OPENAI_BASE_URL=http://localhost:1234/v1
# Local servers ignore the key, but it must be a non-empty string.
OPENAI_API_KEY=local
# Must match a TOOL-CAPABLE model loaded in LM Studio / Ollama / mlx-lm,
# e.g. qwen2.5-7b-instruct, llama-3.1-8b-instruct, mlx-community/Qwen2.5-7B-Instruct-4bit.
LLM_MODEL=qwen2.5-7b-instruct

# --- External API mocks -----------------------------------------------------
# true  = use offline mocks for Tavily web search and Wikipedia (no keys needed).
# false = call the real services (then set TAVILY_API_KEY below).
USE_MOCKS=true
# TAVILY_API_KEY=tvly-xxx        # only needed when USE_MOCKS=false

# --- Optional: LangSmith tracing --------------------------------------------
# Tracing stays OFF unless LANGSMITH_API_KEY is set.
# LANGSMITH_API_KEY=lsv2-xxx
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langchain-academy
