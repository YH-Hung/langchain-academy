# Local LLM (OpenAI-compatible endpoint).
# LM Studio default; Ollama: http://localhost:11434/v1 — mlx-lm: http://localhost:8080/v1
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=local
# Must match a tool-capable model loaded in LM Studio / Ollama / mlx-lm.
LLM_MODEL=qwen2.5-7b-instruct

# Optional: trace to local Langfuse on the host (docker compose -f ../../langfuse/docker-compose.yml up -d)
# LANGSMITH_TRACING=true
# LANGSMITH_TRACING_MODE=otel
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:3000/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic cGstbGYtbGFuZ2NoYWluLWFjYWRlbXk6c2stbGYtbGFuZ2NoYWluLWFjYWRlbXk=
